# DJ Sync Agent — local configuration template
# Copy only the variables that your local config loader supports.
# NEVER commit real secrets.

# ---------------------------------------------------------------------------
# Rekordbox
# ---------------------------------------------------------------------------

# Absolute path to the Rekordbox SQLCipher database.
# Example:
# REKORDBOX_DB_PATH=/Users/YOUR_USER/Library/Pioneer/rekordbox/master.db
REKORDBOX_DB_PATH=

# Rekordbox SQLCipher key, if required by your installation.
# Store the real value only in your local environment file.
REKORDBOX_DB_KEY=

# Keep the exact compatibility/mode expected by the installed project.
# Example placeholder; do not guess a production value.
REKORDBOX_CIPHER_COMPATIBILITY=

# ---------------------------------------------------------------------------
# Supabase / Sync API
# ---------------------------------------------------------------------------

# Stable identifier for this Mac installation.
SYNC_AGENT_ID=

# Production Edge Function endpoint:
# https://<project-ref>.supabase.co/functions/v1/sync-batch
SYNC_API_URL=

# Long random secret shared by the Mac agent and the Edge Function.
# Generate a fresh production value; do not use development credentials.
SYNC_API_KEY=

# ---------------------------------------------------------------------------
# Sync runtime
# ---------------------------------------------------------------------------

CHANGE_BATCH_SIZE=500
SYNC_MAX_BATCHES=20

# 20 seconds default; range supported by the current watcher is 1s–300s.
SYNC_TIMEOUT_MS=20000

# Retry policy.
SYNC_MAX_RETRIES=4
SYNC_RETRY_BASE_MS=1000

# Automatic watcher.
SYNC_WATCH_DEBOUNCE_MS=1500
SYNC_WATCH_RUN_ON_START=true
SYNC_WATCH_DRAIN=false
SYNC_WATCH_POLL_MS=5000

# ---------------------------------------------------------------------------
# Optional health/status CLI
# ---------------------------------------------------------------------------

# https://<project-ref>.supabase.co/functions/v1/sync-health
SYNC_HEALTH_URL=

# ---------------------------------------------------------------------------
# Snapshot sync (only when using the snapshot pipeline)
# ---------------------------------------------------------------------------

# https://<project-ref>.supabase.co/functions/v1/sync-snapshot
SYNC_SNAPSHOT_URL=
SYNC_SNAPSHOT_BATCH_SIZE=250
SYNC_SNAPSHOT_PATH=reports/rekordbox-track-snapshot.ndjson
SYNC_SNAPSHOT_STATE_PATH=reports/rekordbox-snapshot-sync.json
SNAPSHOT_BUILD_STATE_PATH=reports/rekordbox-snapshot-build-state.json

# Electron autonomous intelligence job endpoint
INTELLIGENCE_JOBS_API_URL=
